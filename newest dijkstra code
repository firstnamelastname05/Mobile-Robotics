#define V 8 // Number of vertices in the graph

#include <Arduino.h>

// A utility function to find the vertex with minimum distance value
int minDistance(int dist[], bool sptSet[]) {
  int min = INT_MAX, min_index;
  for (int v = 0; v < V; v++) {
    if (!sptSet[v] && dist[v] <= min) {
      min = dist[v];
      min_index = v;
    }
  }
  return min_index;
}

// Function that implements Dijkstra's algorithm and stores predecessors
void dijkstra(int graph[V][V], int src, int dist[], int pred[]) {
  bool sptSet[V];
  for (int i = 0; i < V; i++) {
    dist[i] = INT_MAX;
    sptSet[i] = false;
    pred[i] = -1;  // No predecessor initially
  }
  dist[src] = 0;

  for (int count = 0; count < V - 1; count++) {
    int u = minDistance(dist, sptSet);
    sptSet[u] = true;

    for (int v = 0; v < V; v++) {
      if (!sptSet[v] && graph[u][v] && dist[u] != INT_MAX && dist[u] + graph[u][v] < dist[v]) {
        dist[v] = dist[u] + graph[u][v];
        pred[v] = u;
      }
    }
  }
}

// Function to count the number of checkpoints between main checkpoints
int countCheckpoints(int pred[], int start, int end) {
  int count = 0;
  int node = end;
  while (pred[node] != -1 && pred[node] != start) {
    count++;
    node = pred[node];
  }
  return count;
}

// The graph initialization (adjacency matrix)
int graph[V][V] = {
  {0, 0, 0, 0, 8, 0, 0, 7},
  {0, 0, 0, 0, 0, 0, 2, 5},
  {0, 0, 0, 8, 0, 0, 0, 7},
  {0, 0, 8, 0, 0, 0, 10, 0},
  {8, 0, 0, 0, 0, 0, 10, 0},
  {0, 0, 0, 0, 0, 0, 10, 0},
  {0, 2, 0, 10, 10, 10, 0, 0},
  {7, 5, 7, 0, 0, 0, 0, 0},
};

void setup() {
  Serial.begin(9600);
  int dist[V], pred[V];
  int route[] = {0, 4, 6, 7}; // Example route (main checkpoints)
  int routeSize = sizeof(route) / sizeof(route[0]);

  dijkstra(graph, 0, dist, pred);

  Serial.println("Route Checkpoints Count:");
  for (int i = 0; i < routeSize - 1; i++) {
    int count = countCheckpoints(pred, route[i], route[i + 1]);
    Serial.print("Checkpoints between ");
    Serial.print(route[i]);
    Serial.print(" and ");
    Serial.print(route[i + 1]);
    Serial.print(": ");
    Serial.println(count);
  }
}

