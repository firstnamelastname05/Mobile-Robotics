// loop function executes repeatedly
void loop() {
    // cycle through sensor values for alignment detection
    int i;
    for (i=0;i<5;i++)
    {
        
        if (activateSensors == 1) {
          
          AnalogValue[i]=analogRead(AnalogPin[i]);
          /*Serial.print(AnalogValue[i]); // This prints the actual analog reading from the sensors
          Serial.print("\t"); //tab over on screen
          if(i==4)
          {
              Serial.println(""); //carriage return
              delay(600); // display new set of readings every 600mS
          }*/

        }
    }

    // reset speed to default if inside & outside sensors are on black
    if(AnalogValue[0] > thresholdLS && AnalogValue[1] > thresholdLS && AnalogValue[3] > thresholdLS && AnalogValue[4] > thresholdLS) {
      straight();
    }

    // when all / any 4 sensors are on white
    if(AnalogValue[0] < thresholdLS && AnalogValue[1] < thresholdLS && AnalogValue[3] < thresholdLS && AnalogValue[4] < thresholdLS && AnalogValue[2] < thresholdLS 
        || AnalogValue[1] < thresholdLS && AnalogValue[3] < thresholdLS && AnalogValue[4] < thresholdLS && AnalogValue[2] < thresholdLS 
        || AnalogValue[0] < thresholdLS && AnalogValue[1] < thresholdLS && AnalogValue[3] < thresholdLS && AnalogValue[2] < thresholdLS) {
        Serial.println("DETECTED");

        if (firstStop == 1) {
          firstStop = 0;
          skippedCount[0]++;
          stop();
          delay(1000);
          straight();
        }

        else if (route[skipIndex + 1] == 5 && route[skipIndex] == 0 && skippedCount[skipIndex] == 2 && currentDirection == -1) {
          skippedCount[skipIndex]--;
          leftTurn();
          
          finish = 1;
          activateSensors = 0;
          for (int num = 0; num < 5; num++) {
              AnalogValue[num] = 1000;
          }
          skippedCount[skipIndex]--;  // decrement skipped count
          straight();
          delay(500);
        }

        else if (route[skipIndex + 1] == 5 && skippedCount[skipIndex] == 1) {
          if (route[skipIndex] == 4 && currentDirection == -1) {
            leftTurn();
          }
          else if (route[skipIndex] == 3 && currentDirection == 1) {
            rightTurn();           
          }
          else if (route[skipIndex] == 1 && currentDirection == 1) {
            straight();            
          }          

          finish = 1;
          activateSensors = 0;
          for (int num = 0; num < 5; num++) {
              AnalogValue[num] = 1000;
          }
          skippedCount[skipIndex]--;  // decrement skipped count
          straight();
          delay(500);
        }

        else if ((route[skipIndex + 1] == 5) && (skippedCount[skipIndex] == 3) && (route[skipIndex] == 2) && currentDirection == -1) {
            rightTurn();
            straight();
            skippedCount[skipIndex]--;  // decrement skipped count
        }

        else if ((route[skipIndex + 1] == 5) && (skippedCount[skipIndex] == 3) && (route[skipIndex] == 0) && currentDirection == 1) {
            leftTurn();
            straight();
            skippedCount[skipIndex]--;  // decrement skipped count
        }

        if (route[0] == 0 && route[1] == 4 && firstReverse == 1) {
          reverse();
          firstReverse = 0;
          straight();
          skippedCount[skipIndex]--;
        }

        // if no checkpoints are to be skipped before desired checkpoint
        else if (skippedCount[skipIndex] == 0) {
          stop();
          updateCloud();
          straight();

          if (skipIndex <= routeLength - 1) {
            skipIndex++;
            checkpoint = route[skipIndex];
          }
          else {
            skipIndex = 0;
          }

          if (route[skipIndex] == 1 && (route[skipIndex + 1] == 3 || route[skipIndex + 1] == 0)) {
            currentDirection*= -1;
          }

          if (route[skipIndex] == 2 && route[skipIndex + 1] == 1 && currentDirection == 1) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 0 && route[skipIndex + 1] == 1 && currentDirection == -1) {
            reverse();
            straight();
          }

          if (route[skipIndex - 1] == route[skipIndex + 1]) {
            reverse();
            straight();
          }

          if ((route[skipIndex - 1] == 3 || route[skipIndex - 1] == 4) && (route[skipIndex] == 1) && (route[skipIndex + 1] == 3 || route[skipIndex + 1] == 4 || route[skipIndex + 1] == 5)) {
            reverse();
            straight();
          }

          if ((route[skipIndex - 1] == 2 || route[skipIndex - 1] == 0) && (route[skipIndex] == 1) && (route[skipIndex + 1] == 2 || route[skipIndex + 1] == 0)) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 2 && route[skipIndex + 1] == 5 && currentDirection == 1) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 0 && route[skipIndex + 1] == 5 && currentDirection == -1) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 4 && route[skipIndex + 1] == 5 && currentDirection == 1) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 3 && route[skipIndex + 1] == 5 && currentDirection == -1) {
            reverse();
            straight();
          }

          if (route[skipIndex + 1] == 1 && route[skipIndex] == 4 && currentDirection == 1) {
            reverse();
            straight();
          }

          if (route[skipIndex + 1] == 1 && route[skipIndex] == 3 && currentDirection == -1) {
            reverse();
            straight();
          }

          if ((route[skipIndex] == 2 && route[skipIndex + 1] == 4 && currentDirection == 1) || (route[skipIndex] == 4 && route[skipIndex + 1] == 2 && currentDirection == -1)) {
            reverse();
            straight();
          }

          if ((route[skipIndex] == 0 && route[skipIndex + 1] == 3 && currentDirection == -1) || (route[skipIndex] == 3 && route[skipIndex + 1] == 0 && currentDirection == 1)) {
            reverse();
            straight();
          }

          if (route[skipIndex] == 1 && route[skipIndex + 1] == 5 && currentDirection == -1) {
            reverse();
            straight();
          }

            delay(250);
        }

        else if ((skippedCount[skipIndex] == 1) && (route[skipIndex + 1] == 1) && (route[skipIndex] == 0 || route[skipIndex] == 3) && (currentDirection == 1)) {
            leftTurn();
            skippedCount[skipIndex]--;  // decrement skipped count
            straight();
            delay(250);
        }
        
        else if ((skippedCount[skipIndex] == 1) && (route[skipIndex + 1] == 1) && (route[skipIndex] == 2 || route[skipIndex] == 4) && (currentDirection == -1)) {
            rightTurn();
            skippedCount[skipIndex]--;  // decrement skipped count
            straight();
            delay(250);            
        }

        else if ((route[skipIndex] == 1) && (route[skipIndex+1] == 2 || route[skipIndex+1] == 4)) {
          leftTurn();
          straight();
          skippedCount[skipIndex]--;
        }

        else if ((route[skipIndex] == 1) && (route[skipIndex+1] == 3 || route[skipIndex+1] == 0)) {
          rightTurn();
          straight();
          skippedCount[skipIndex]--;
        }

        else if (((route[skipIndex] == 2 && route[skipIndex + 1] == 3) || ((route[skipIndex] == 4 && route[skipIndex + 1] == 0))) && (skippedCount[skipIndex] == 3 || skippedCount[skipIndex] == 1)) {
          rightTurn();
          straight();
          skippedCount[skipIndex]--;
        }

        else if (((route[skipIndex] == 3 && route[skipIndex + 1] == 2) || ((route[skipIndex] == 0 && route[skipIndex + 1] == 4))) && (skippedCount[skipIndex] == 3 || skippedCount[skipIndex] == 1)) {
          leftTurn();
          straight();
          skippedCount[skipIndex]--;
        }

        else if (route[skipIndex] == 0 && route[skipIndex + 1] == 2 && currentDirection == -1 && skippedCount[skipIndex] == 3) {
              rightTurn();
              straight();
              currentDirection = 1;
              skippedCount[skipIndex]--;
        }
        
        else if (route[skipIndex] == 0 && route[skipIndex + 1] == 2 && currentDirection == 1 && skippedCount[skipIndex] == 1) {
              leftTurn();
              straight();
              skippedCount[skipIndex]--;
        }

        else if (route[skipIndex] == 0 && route[skipIndex + 1] == 1 && currentDirection == -1 && skippedCount[skipIndex] == 1) {
              rightTurn();
              straight();
              skippedCount[skipIndex]--;
        }

        else if (route[skipIndex] == 0 && route[skipIndex + 1] == 5 && currentDirection == -1 && skippedCount[skipIndex] == 1) {
              leftTurn();
              straight();
              skippedCount[skipIndex]--;
        }

        // if skipping a checkpoint
        else {
          skippedCount[skipIndex]--;
          straight();
          delay(250);
        }
    }

    // inside sensors speed change
    if(AnalogValue[1] < thresholdLS)
    {
        leftInsideSensorCorrection();
    }
    if(AnalogValue[3] < thresholdLS)
    {
        rightInsideSensorCorrection();
    }

    // outside sensors speed change
    if(AnalogValue[0] < thresholdLS)
    {
        leftOutsideSensorCorrection();
    }
    if(AnalogValue[4] < thresholdLS)
    {
        rightOutsideSensorCorrection();
    }

    // read analog values of distance sensor
    distanceValue = analogRead(distancePin);
    delay(10);

    // increase count when mobot close to obstruction/wall
    if(distanceValue > 2000) {
        consecCount++;
    }
    // if consecutive readings aren't high enough reset count
    else {
        consecCount = 0;
    }

    // when targetCount number of consecutive readings are high
    if(consecCount == targetCount) {
      stop();

      if (finish == 1) {
        updateCloud();
        client.stop();
        while(true);
      }
      else if (finish == 0) {
        // turn 180 degrees
        reverse();

        if ((route[skipIndex] == 2 && route[skipIndex + 1] == 3) || (route[skipIndex] == 3 && route[skipIndex + 1] == 2) || (route[skipIndex] == 0 && route[skipIndex + 1] == 4) || (route[skipIndex] == 4 && route[skipIndex + 1] == 0)) {
          node1 = route[skipIndex];
          node2 = route[skipIndex + 1];
          graph[node1][node2] = 1000;
          graph[node2][node1] = 1000;         
        }
        
        if (route[skipIndex] == 0 && (route[skipIndex + 1] == 2 || route[skipIndex + 1] == 5 || route[skipIndex + 1] == 1 || route[skipIndex + 1] == 3) && skippedCount[skipIndex] == 1) {
          graph[0][7] = 1000;
          graph[7][0] = 1000;
        }

        if (route[skipIndex] == 0 && (route[skipIndex + 1] == 2 || route[skipIndex + 1] == 3) && skippedCount[skipIndex] == 0) {
          graph[0][7] = 1000;
          graph[7][0] = 1000;
        }

        if (route[skipIndex] == 2 && route[skipIndex + 1] == 0 && skippedCount[skipIndex] == 1) {
          graph[2][7] = 1000;
          graph[7][2] = 1000;
        }
        if (route[skipIndex] == 2 && route[skipIndex + 1] == 0 && skippedCount[skipIndex] == 0) {
          graph[2][7] = 1000;
          graph[7][2] = 1000;
        }

        if (route[skipIndex] == 3 && route[skipIndex + 1] == 4 && skippedCount[skipIndex] == 1) {
          graph[3][6] = 1000;
          graph[6][3] = 1000;
        }
        if (route[skipIndex] == 3 && route[skipIndex + 1] == 4 && skippedCount[skipIndex] == 0) {
          graph[3][6] = 1000;
          graph[6][3] = 1000;
        }        

        if (route[skipIndex] == 4 && route[skipIndex + 1] == 3 && skippedCount[skipIndex] == 1) {
          graph[4][6] = 1000;
          graph[6][4] = 1000;
        }
        if (route[skipIndex] == 4 && route[skipIndex + 1] == 3 && skippedCount[skipIndex] == 0) {
          graph[4][6] = 1000;
          graph[6][4] = 1000;
        }     

        if((route[skipIndex] == 3 || route[skipIndex] == 4) && route[skipIndex + 1] == 1 && skippedCount[skipIndex] == 0) {
          graph[1][6] = 1000;
          graph[6][1] = 1000;
        } 

        if((route[skipIndex] == 0 || route[skipIndex] == 2) && route[skipIndex + 1] == 1 && skippedCount[skipIndex] == 0) {
          graph[1][7] = 1000;
          graph[7][1] = 1000;
        }     

        processRoute(graph, route, routeLength); 
        skippedCount[skipIndex]++;
      }

      // when sensor returns to path
      if(AnalogValue[2] < thresholdLS) {
          straight();
          delay(250);
      }
    }    
}
